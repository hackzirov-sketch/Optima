{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://api.honeymedia.uz/api/:path*" },
    { "source": "/socket.io/:path*", "destination": "https://api.honeymedia.uz/socket.io/:path*" },
    { "source": "/uploads/:path*", "destination": "https://api.honeymedia.uz/uploads/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
