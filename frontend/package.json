{
  "name": "@workspace/optima-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:education": "vite build --config education-module/vite.config.js",
    "predev": "npm run build:education",
    "predev:lan": "npm run build:education",
    "dev": "vite",
    "dev:lan": "node scripts/dev-lan.mjs",
    "build": "npm run build:education && tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "start": "vite preview --host 0.0.0.0",
    "test": "vitest run"
  },
  "dependencies": {
    "@lottiefiles/dotlottie-react": "0.19.13",
    "livekit-client": "2.22.3",
    "lucide-react": "^0.545.0",
    "quick-liquid": "0.1.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-router-dom": "^6.30.1",
    "socket.io-client": "^4.8.3",
    "wouter": "^3.3.5"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "jsdom": "^30.1.3",
    "typescript": "~5.9.2",
    "vite": "^7.3.2",
    "vitest": "^4.1.7"
  },
  "license": "MIT",
  "author": "Elbek Rustamjanov"
}
