# App
NODE_ENV=production
PORT=3000
API_PREFIX=api/v1
FRONTEND_URL=https://upz.dev
# Password hashing (10–15, default 12 per security baseline)
BCRYPT_ROUNDS=12

# Database
DATABASE_URL=postgresql://upz:password@localhost:5432/upz
DATABASE_POOL_SIZE=10

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=your-32-char-secret
JWT_REFRESH_SECRET=your-32-char-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# GitHub App
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=        # PEM format
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=upz-pushes
R2_PUBLIC_URL=https://r2.upz.dev

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=upz
# Where direct uploads, long messages and push bundles go: cloudinary (default) | r2
STORAGE_PROVIDER=cloudinary

# Encryption (for GitHub tokens)
ENCRYPTION_KEY=32-char-aes-key

# Chat message encryption (AES-256-CBC) — generate with: openssl rand -hex 32
CHAT_ENCRYPTION_KEY=32-char-aes-key

# TURN (WebRTC relay for meetings — run `docker compose up -d coturn`)
#
# Handed to the browser verbatim by GET /meetings/ice-servers, so in production
# this must resolve from the public internet. "localhost" makes every client
# dial its own machine: locally that costs nothing because peers on one LAN
# connect directly, but across two NATs it is the difference between seeing
# each other's camera and seeing nothing. See the root .env.example for the
# matching coturn settings (TURN_EXTERNAL_IP, TLS).
TURN_URLS=turn:localhost:3478
# Preferred. Must be the same secret the coturn service runs with, otherwise
# every credential this API issues is rejected and no relay is available.
TURN_SECRET=
TURN_TTL_SECONDS=3600
# Fallback, used only while TURN_SECRET is empty.
TURN_USERNAME=upzturn
TURN_CREDENTIAL=change-me

# Email
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=
# Optional sender address (required for SendGrid; defaults to SMTP_USER for Gmail).
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_USER=<gmail address>, SMTP_PASS=<16-letter app password>
SMTP_FROM=

# Storage
PUSH_ARTIFACT_TTL_DAYS=7
YOUTUBE_API_KEY=

# Comma-separated user IDs allowed to administer platform-wide content
# (the education catalogue). Empty grants nobody access.
PLATFORM_ADMIN_USER_IDS=
