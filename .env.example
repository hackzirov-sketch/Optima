# Copy to .env and fill in real values before `docker compose up -d`.
# Generate secrets with: openssl rand -hex 32

# --- Postgres ---
POSTGRES_USER=upz
POSTGRES_PASSWORD=
POSTGRES_DB=upz

# --- Database backup (second Postgres, see backend/docker/backup/backup.sh) ---
BACKUP_POSTGRES_USER=backup
BACKUP_POSTGRES_PASSWORD=
BACKUP_INTERVAL_HOURS=6
BACKUP_KEEP_DAYS=7


# --- Redis ---
REDIS_PASSWORD=

# --- App URLs ---
FRONTEND_URL=https://your-domain.com
NEXT_PUBLIC_API_URL=https://your-domain.com/api/v1
NEXT_PUBLIC_WS_URL=https://your-domain.com
NEXT_PUBLIC_DEMO_MODE=false

# --- Auth ---
BCRYPT_ROUNDS=12
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# --- GitHub App (optional — leave blank to disable) ---
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Google OAuth (optional — leave blank to disable) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://your-domain.com/api/v1/auth/google/callback

# --- Object storage (S3-compatible: AWS S3, Cloudflare R2, MinIO) ---
# Files are uploaded by the browser straight to storage on a presigned URL, so
# these must be real: with credentials missing the API refuses uploads outright
# (503 STORAGE_PROVIDER_UNAVAILABLE) rather than handing out a URL to nowhere.
# Verify the whole chain with `cd backend && npm run check:storage`.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
# AWS: the bucket's region, and leave S3_ENDPOINT unset — the SDK derives the
# host from it. Anything else (R2, MinIO): set S3_ENDPOINT to the API host.
S3_REGION=eu-north-1
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# Where objects are *served* from. Also the only host attachments are accepted
# from (StorageService.assertOwnedAttachment), so a placeholder here silently
# rejects files that uploaded fine.
S3_PUBLIC_URL=https://<bucket>.s3.<region>.amazonaws.com
#
# The bucket needs two things set on it, or uploads fail before they start:
#   1. CORS — apply backend/docker/s3-cors.json with your own origins, else
#      the browser's preflight fails whatever the signature says;
#   2. public read on the app's prefixes (attachments/, avatars/, ...), since
#      that is what S3_PUBLIC_URL serves. Objects carry unguessable UUID keys,
#      but anyone holding a URL can read it — swap to presigned GETs or put
#      CloudFront in front when that is not acceptable.
#
# The older R2_ACCOUNT_ID / R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY /
# R2_BUCKET_NAME / R2_PUBLIC_URL names are still read, so an existing R2
# deployment needs no changes.

# --- Cloudinary (image storage) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=upz

# --- Encryption (32 chars each) ---
ENCRYPTION_KEY=
CHAT_ENCRYPTION_KEY=

# --- TURN (WebRTC relay for meetings — docker-compose coturn service) ---
#
# Two participants on the same machine or LAN connect over host candidates and
# never touch TURN, so meetings look fine locally no matter what is set here.
# Two participants behind different NATs usually cannot, and without a working
# relay their cameras and screen shares simply never arrive. Every value below
# matters only in production, which is exactly why it is easy to get wrong.
TURN_REALM=upz.local
# The address CLIENTS dial. It is handed to the browser as-is, so it must be a
# name or IP reachable from the public internet — "localhost" here means each
# browser tries its own machine and TURN is silently unavailable.
#   dev:  turn:localhost:3478
#   prod: turn:turn.example.com:3478[,turns:turn.example.com:5349]
TURN_URLS=turn:localhost:3478
# Preferred: a secret shared with coturn (`use-auth-secret` / `static-auth-secret`).
# The API then mints a short-lived, per-user credential for each client instead of
# handing everyone the same password — a static one lives in every user's browser
# and devtools log, and relaying is the expensive thing a TURN server does.
# The bundled coturn picks its auth mode from this same variable, so the two
# sides cannot drift apart; setting it on only one of them rejects every
# allocation with a 401 and leaves calls with no relay at all.
TURN_SECRET=
TURN_TTL_SECONDS=3600
# Legacy static pair. Only used when TURN_SECRET is unset; prefer the above.
TURN_USERNAME=upzturn
TURN_CREDENTIAL=
# Must be this server's real reachable address for cross-network calls.
TURN_PUBLIC_HOST=
# The public IP (an address, not a name) when the TURN host itself sits behind
# a 1:1 NAT, as any cloud VM does. Without it coturn advertises its private
# address and the relay candidates it offers are unusable.
TURN_EXTERNAL_IP=
# Optional TLS listener, so clients on networks that permit nothing but 443 can
# still relay. Paths are inside the coturn container; mount the cert to use it.
TURN_TLS_CERT=
TURN_TLS_KEY=
TURN_TLS_PORT=5349

# --- Email (SMTP) ---
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=

PUSH_ARTIFACT_TTL_DAYS=7
YOUTUBE_API_KEY=
