# Copy to .env and fill in real values before `docker compose up -d`.
# Generate secrets with: openssl rand -hex 32

# --- Postgres ---
POSTGRES_USER=upz
POSTGRES_PASSWORD=
POSTGRES_DB=upz


# --- Redis ---
REDIS_PASSWORD=

# --- App URLs ---
FRONTEND_URL=https://your-domain.com
NEXT_PUBLIC_API_URL=https://your-domain.com/api/v1
NEXT_PUBLIC_WS_URL=https://your-domain.com
NEXT_PUBLIC_DEMO_MODE=false

# --- Auth ---
BCRYPT_ROUNDS=12
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# --- GitHub App (optional — leave blank to disable) ---
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Google OAuth (optional — leave blank to disable) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://your-domain.com/api/v1/auth/google/callback

# --- Cloudflare R2 (file storage) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=upz-pushes
R2_PUBLIC_URL=

# --- Encryption (32 chars each) ---
ENCRYPTION_KEY=
CHAT_ENCRYPTION_KEY=

# --- TURN (WebRTC relay for meetings — docker-compose coturn service) ---
TURN_REALM=upz.local
TURN_USERNAME=upzturn
TURN_CREDENTIAL=
# Must be this server's real reachable address for cross-network calls.
TURN_PUBLIC_HOST=

# --- Email (SMTP) ---
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=

PUSH_ARTIFACT_TTL_DAYS=7
