# ═══════════════════════════════════════════
# Required
# ═══════════════════════════════════════════
PORT=5173
BASE_PATH=/

# ═══════════════════════════════════════════
# API Server (artifacts/api-server)
# ═══════════════════════════════════════════
DATABASE_URL=postgresql://user:pass@localhost:5432/upz
CORS_ORIGINS=http://localhost:5173

# ═══════════════════════════════════════════
# Optional
# ═══════════════════════════════════════════
LOG_LEVEL=info
NODE_ENV=development
ALLOWED_HOSTS=localhost,127.0.0.1
